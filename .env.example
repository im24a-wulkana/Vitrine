# Leave DATABASE_URL blank to run in local mode: no sign-in, data stays on this computer.

# Neon project > Connect. Use the pooled connection string.
DATABASE_URL=
# Optional: the direct connection string, used only for npm run db:migrate.
DATABASE_URL_UNPOOLED=

# Neon project > Auth. The secret is any random string of 32+ characters: openssl rand -base64 32
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Private photo storage. Vercel adds this when you connect a Blob store.
# Without it, photos are saved on this computer, which is fine for local testing.
BLOB_READ_WRITE_TOKEN=

# Google account to load sample data into with npm run seed (optional). Sign in with it once first.
SEED_USER_EMAIL=

# AI tagging and outfit generation. Server only: never prefix these with NEXT_PUBLIC_.
# Leave blank to run without AI.
ANTHROPIC_API_KEY=

# Reserved for a future Gemini provider. Not used yet.
GEMINI_API_KEY=

# Web push notifications. Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: address of yours, sent to push services as a contact.
VAPID_SUBJECT=

# Protects the scheduled notification check. Any long random string. Vercel sends
# it automatically to cron routes when it's set as an environment variable.
CRON_SECRET=
