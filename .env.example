# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Only used by scripts/seed.ts. Never expose it to the browser or add it to Vercel.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Account the seed script creates (or reuses) and fills with sample data.
SEED_USER_EMAIL=demo@vitrine.test
SEED_USER_PASSWORD=choose-a-local-password

# AI tagging and outfit generation. Server only: never prefix these with NEXT_PUBLIC_.
# Leave blank to run without AI.
ANTHROPIC_API_KEY=

# Reserved for a future Gemini provider. Not used yet.
GEMINI_API_KEY=

# Web push notifications. Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: address of yours, sent to push services as a contact.
VAPID_SUBJECT=

# Protects the scheduled notification check. Any long random string. Vercel sends
# it automatically to cron routes when it's set as an environment variable.
CRON_SECRET=
